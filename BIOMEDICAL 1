est_dev_f1 = train_one_model(model, train_loader, dev_loader)\n","\n","p_cdr, r_cdr, f1_cdr = entity_level_f1(model, cdr_loader, device)\n","p_ncbi, r_ncbi, f1_ncbi = entity_level_f1(model, ncbi_loader, device)\n","print(f\"\\n  >> CDR  Test — P:{p_cdr:.4f} R:{r_cdr:.4f} F1:{f1_cdr:.4f}\")\n","print(f\"  >> NCBI Test — P:{p_ncbi:.4f} R:{r_ncbi:.4f} F1:{f1_ncbi:.4f}\")\n","\n","torch.save(model.state_dict(), \"/content/drive/MyDrive/BIOMEDICAL/FIXED_BioBERT_CDR_only_seed2024.pt\")\n","\n","df_existing = pd.read_csv(\"/content/drive/MyDrive/BIOMEDICAL/FIXED_ablation_single_corpus.csv\")\n","new_row = pd.DataFrame([{\n","    \"TrainCorpus\": \"CDR_only\", \"Seed\": 2024,\n","    \"CDR_Precision\": p_cdr, \"CDR_Recall\": r_cdr, \"CDR_F1\": f1_cdr,\n","    \"NCBI_Precision\": p_ncbi, \"NCBI_Recall\": r_ncbi, \"NCBI_F1\": f1_ncbi,\n","}])\n","df_final = pd.concat([df_existing, new_row], ignore_index=True)\n","df_final.to_csv(\"/content/drive/MyDrive/BIOMEDICAL/FIXED_ablation_single_corpus.csv\", index=False)\n","print(\"\\n=== GÜNCEL TAM TABLO (6/6) ===\")\n","print(df_final.to_string())"],"metadata":{"id":"0GYMjS2GlCif"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def encode_dataset_512(dataset, tokenizer, max_len=512):\n","    encoded = []\n","    for sample in dataset:\n","        tokens, labels = sample[\"tokens\"], sample[\"labels\"]\n","        enc = tokenizer(tokens, is_split_into_words=True, truncation=True,\n","                         padding=\"max_length\", max_length=max_len, return_tensors=\"pt\")\n","        word_ids = enc.word_ids()\n","        aligned = [0 if wid is None else labels[wid] for wid in word_ids]\n","        encoded.append({\n","            \"input_ids\": enc[\"input_ids\"].squeeze(),\n","            \"attention_mask\": enc[\"attention_mask\"].squeeze(),\n","            \"labels\": torch.tensor(aligned),\n","            \"word_ids\": [(-1 if w is None else w) for w in word_ids]   # <-- EKLENEN SATIR\n","        })\n","    return encoded"],"metadata":{"id":"C3c3EufV1hO1"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def entity_level_f1_wordlevel(model, data_loader, device, word_ids_list):\n","    model.eval()\n","    all_pred, all_true = [], []\n","    idx = 0\n","    with torch.no_grad():\n","        for batch in data_loader:\n","            input_ids = batch[\"input_ids\"].to(device)\n","            attention_mask = batch[\"attention_mask\"].to(device)\n","            labels = batch[\"labels\"]\n","            predictions = model(input_ids=input_ids, attention_mask=attention_mask)\n","            for pred_seq, label_seq in zip(predictions, labels):\n","                wids = word_ids_list[idx]; idx += 1\n","                # her kelimenin SADECE ilk subword'ünü al\n","                seen = set(); w_pred, w_true = [], []\n","                for pos, wid in enumerate(wids):\n","                    if wid is None or wid in seen:\n","                        continue\n","                    seen.add(wid)\n","                    w_pred.append(pred_seq[pos])\n","                    w_true.append(label_seq[pos].item())\n","                all_pred.append(set(extract_entities(w_pred)))\n","                all_true.append(set(extract_entities(w_true)))\n","    tp = sum(len(p & t) for p, t in zip(all_pred, all_true))\n","    fp = sum(len(p - t) for p, t in zip(all_pred, all_true))\n","    fn = sum(len(t - p) for p, t in zip(all_pred, all_true))\n","    prec = tp / (tp + fp + 1e-8); rec = tp / (tp + fn + 1e-8)\n","    f1 = 2*prec*rec / (prec+rec+1e-8)\n","    return prec, rec, f1, tp, fp, fn"],"metadata":{"id":"oZ839gh26OHT"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import pandas as pd\n","CKPT_DIR = \"/content/drive/MyDrive/BIOMEDICAL/ARCHIVE_pre_windowing\"\n","\n","RUNS = {\n"," \"Joint_NoInstr\": (\"dmis-lab/biobert-base-cased-v1.1\", {\n","     42:\"FIXED_BioBERT_NoInstruction.pt\", 123:\"FIXED_BioBERT_NoInstruction_seed123.pt\", 2024:\"